
#include <stdio.h>

int main() {
    int birthYear[4];  
    int age[4];        
    int sum = 0;
    int maxAge, minAge;
    float averageAge;

    
    for (int i = 0; i < 4; i++) {
        printf("Enter the birth year of student %d: ", i + 1);
        scanf("%d", &birthYear[i]);
    }

    
    for (int i = 0; i < 4; i++) {
        age[i] = 2025 - birthYear[i];  
        sum += age[i];  
    }

    
    averageAge = (float)sum / 4;

    
    maxAge = age[0];  
    minAge = age[0];  

    for (int i = 1; i < 4; i++) {
        if (age[i] > maxAge) {
            maxAge = age[i];  
        }
        if (age[i] < minAge) {
            minAge = age[i];  
        }
    }

    
    printf("The average age is: %.2f\n", averageAge);
    printf("The maximum age is: %d\n", maxAge);
    printf("The minimum age is: %d\n", minAge);

    return 0;
}
